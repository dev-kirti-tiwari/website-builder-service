NODE_ENV=development
PORT=4070
DATABASE_URL=postgresql://pagebuilder:pagebuilder_dev@localhost:5434/page_builder
INTERNAL_SERVICE_TOKEN=replace_with_secret
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
