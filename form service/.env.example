NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_api
DATABASE_POOL_MAX=10
# direct-jwt | gateway-context
AUTH_MODE=direct-jwt
# Placeholders only - populate from the real platform configuration (min 32 chars)
JWT_SECRET=<min-32-char-secret>
JWT_ISSUER=<configured-issuer>
JWT_AUDIENCE=<configured-audience>
# Only for AUTH_MODE=gateway-context
INTERNAL_SERVICE_TOKEN=<secret-manager-injected-secret>
PUBLIC_RATE_LIMIT_MAX=30
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT=100kb
OUTBOX_WORKER_ENABLED=true
# Comma-separated browser origins allowed by CORS (empty = disabled)
CORS_ORIGINS=
