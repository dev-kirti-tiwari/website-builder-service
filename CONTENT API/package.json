{
  "name": "content-api-service",
  "version": "2.0.0",
  "description": "Content API Service - section content, revisions and autosave for the Independent Website Builder",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "token": "node scripts/generate-token.js",
    "postman:env": "node scripts/postman-env.js",
    "postman:test": "node scripts/run-postman.js",
    "test": "node --test \"tests/unit/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "newman": "^6.2.3"
  }
}
