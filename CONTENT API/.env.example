NODE_ENV=development
PORT=4080
LOG_LEVEL=info

# Docker Compose database (also used to build DATABASE_URL inside the compose network)
POSTGRES_USER=content_api
POSTGRES_PASSWORD=replace_with_secret
POSTGRES_DB=content_api
POSTGRES_HOST_PORT=5435

# Used when running the API directly on the host (npm start / npm run migrate)
DATABASE_URL=postgresql://content_api:replace_with_secret@localhost:5435/content_api

# BRR/JWT verification - match the existing authentication implementation.
# HS256: set JWT_SECRET.  RS256/ES256: set JWT_PUBLIC_KEY (PEM, \n escaped) instead.
JWT_SECRET=replace_with_secret
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

INTERNAL_SERVICE_TOKEN=replace_with_secret
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BODY_LIMIT=512kb

# Page Builder section verification on create/duplicate: enabled | disabled
PAGE_BUILDER_VALIDATION=disabled
PAGE_BUILDER_BASE_URL=http://page-builder:4070
PAGE_BUILDER_SECTION_PATH=/api/v1/internal/sections/{sectionId}
MEDIA_BASE_URL=http://media-api:4090
MEDIA_VALIDATION=disabled
# Leave AUDIT_BASE_URL empty to log audit events locally only
AUDIT_BASE_URL=
AUDIT_EVENTS_PATH=/api/v1/events
