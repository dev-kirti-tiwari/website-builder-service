POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=triostack_publishing
POSTGRES_HOST_PORT=5433
API_HOST_PORT=4010
# HS256 shared secret, min 32 chars. Replace with the Identity service's trusted key material.
JWT_SECRET=<SHARED_HS256_SECRET_MIN_32_CHARS>
JWT_ISSUER=<EXISTING_IDENTITY_ISSUER>
JWT_AUDIENCE=<PUBLISHING_API_AUDIENCE>
PUBLISHING_MAX_RETRIES=5
PUBLISHING_STAGE_DELAY_MS=150
# Seeds demo websites/revisions used by the Postman collection. Keep false outside local testing.
SEED_DEMO=false
