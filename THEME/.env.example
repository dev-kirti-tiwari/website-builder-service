# Theme API - environment template. Copy to .env and replace every placeholder.
NODE_ENV=development
PORT=4065
LOG_LEVEL=info

POSTGRES_USER=theme
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=theme_api
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://theme:change-me-postgres-password@localhost:5433/theme_api
DB_POOL_MAX=10

# HS256 signing secret shared with the Auth service (min 32 chars). Never commit a real value.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=
JWT_AUDIENCE=
# Optional BFF-to-service secret (min 16 chars). If set, X-Internal-Service-Token is mandatory.
INTERNAL_SERVICE_TOKEN=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
THEME_MAX_CONFIG_BYTES=262144

AUDIT_SERVICE_URL=
AUDIT_SERVICE_TOKEN=
