# Copy to .env (git-ignored). Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=change_me
STATIC_INTERNAL_TOKEN=inject-from-secret-manager-min-16-chars
DATABASE_URL=postgresql://app_user:change_me@localhost:5442/template_service

# Optional overrides (defaults shown)
# PORT=4018
# INTEGRATIONS_MODE=stub          # http fails closed (503) until downstream contracts are wired
# WEBSITE_SERVICE_URL=http://website-service:4015
# DOCUMENT_SERVICE_URL=http://page-document-service:4022
# MEDIA_SERVICE_URL=http://media-service:4020
# NAVIGATION_SERVICE_URL=http://navigation-service:<confirmed-port>
# THEME_SERVICE_URL=http://theme-service:<confirmed-port>
# DB_POOL_MAX=10
# RATE_LIMIT_PER_MINUTE=1000
# RECONCILE_INTERVAL_MS=30000
# LOG_LEVEL=info
