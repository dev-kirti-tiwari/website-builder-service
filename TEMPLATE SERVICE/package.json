{
  "name": "template-service-api",
  "version": "1.0.0",
  "private": true,
  "description": "Template Service API microservice for the Website Builder platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts up",
    "migrate:down": "tsx src/database/migrate.ts down",
    "migrate:prod": "node dist/database/migrate.js up",
    "test": "vitest run",
    "postman:generate": "node postman/generate.js",
    "postman:run": "newman run postman/template-service.postman_collection.json","postman:run:errors": "newman run postman/template-service-errors.postman_collection.json"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "newman": "^6.2.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
